  <div class="head">
    <div><h1 id="title">Home</h1><p id="subtitle"></p></div>
    <button class="btn" id="scanBtn">Scan System</button>
  </div>

  <!-- HOME -->
  <div class="page" id="p-home">
    <div class="gauges">
      <div class="card"><div class="gauge-top"><span>CPU</span><b id="cpu">-</b></div><div class="bar"><i id="cpuBar"></i></div><div class="small" id="cpuName" style="margin-top:6px"></div></div>
      <div class="card"><div class="gauge-top"><span>Memory</span><b id="ram">-</b></div><div class="bar"><i id="ramBar"></i></div><div class="small" id="ramD" style="margin-top:6px"></div></div>
      <div class="card"><div class="gauge-top"><span>System drive free</span><b id="disk">-</b></div><div class="bar"><i id="diskBar"></i></div><div class="small" id="diskD" style="margin-top:6px"></div></div>
    </div>
    <h2 class="sec">Quick actions</h2>
    <div class="quick" id="quick"></div>
    <p class="small" id="osLine" style="margin-top:18px"></p>
  </div>

  <!-- BOOST -->
  <div class="page" id="p-boost" hidden>
    <div class="pills">
      <button id="tabProfiles" class="on">Profiles</button>
      <button id="tabScan">Smart Scan</button>
    </div>
    <div id="boostProfiles">
      <div class="cards" id="cards"></div>
      <p class="small" style="margin-top:14px">Applying a profile creates a restore point first. "Undo" puts that profile's tweaks back to Windows defaults. Some tweaks need a restart or sign-out.</p>
    </div>
    <div id="boostScan" hidden></div>
  </div>

  <!-- FINE TUNE -->
  <div class="page" id="p-fine" hidden>
    <div class="tools">
      <input id="q" type="search" placeholder="Search tweaks...">
    </div>
    <div class="pills" id="chips"></div>
    <div id="fineList"></div>
  </div>

  <!-- TOOLS -->
  <div class="page" id="p-tools" hidden>
    <div id="toolList"></div>
  </div>
</main>

<div id="toast" role="status"></div>

<script>
const TOKEN = "__TOKEN__";
const $ = id => document.getElementById(id);

const PAGES = {
  home:  ["Home", "Your PC at a glance, plus one-click actions."],
  boost: ["Performance Boost", "Pick a profile, or run a scan to see what your PC is missing."],
  fine:  ["Fine Tune", "Every tweak, one switch at a time."],
  tools: ["Tools", "Cleanup, network, repair and startup apps."]
};
const FINE_ORDER = ["Gaming", "Streaming", "Power", "Network", "Visuals", "Privacy", "Windows Update", "System", "Services"];
const TOOL_ORDER = ["Safety", "Streaming", "Memory", "Cleanup", "Network", "Repair"];
const RELOAD_JOBS = ["undo", "preset-on", "preset-off"];
const QUICK = [
  ["restore", "Create restore point"], ["preset-on", "Streaming mode: on"], ["preset-off", "Streaming mode: off"],
  ["boost", "Raise game and stream priority"], ["trimram", "Free up RAM"], ["temp", "Clear temporary files"], ["ping", "Check my ping"]
];
const TAGS = { essential: "BOOST", competitive: "FPS", max: "MAX" };

let STATE = null;
let STARTUP = [];
let chip = "All";

async function api(path, method) {
  const r = await fetch(path, { method: method || "GET", headers: { "X-Token": TOKEN } });
  let data = null;
  try { data = await r.json(); } catch (e) { }
  if (!r.ok) throw new Error((data && data.message) || ("Request failed (" + r.status + ")"));
  return data;
}

let toastTimer;
function toast(msg, isErr) {
  const t = $("toast");
  t.textContent = msg;
  t.className = "show" + (isErr ? " err" : "");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => { t.className = ""; }, 6000);
}

function el(tag, props, ...kids) {
  const e = document.createElement(tag);
  for (const k in (props || {})) {
    if (k === "class") e.className = props[k]; else e[k] = props[k];
  }
  kids.flat().forEach(c => { if (c) e.append(c); });
  return e;
}

/* ---------- navigation ---------- */
function go(name) {
  document.querySelectorAll(".page").forEach(p => { p.hidden = p.id !== "p-" + name; });
  document.querySelectorAll("#nav button").forEach(b => b.classList.toggle("on", b.dataset.page === name));
  $("title").textContent = PAGES[name][0];
  $("subtitle").textContent = PAGES[name][1];
}
document.querySelectorAll("#nav button").forEach(b => { b.onclick = () => go(b.dataset.page); });

function boostTab(which) {
  $("tabProfiles").classList.toggle("on", which === "profiles");
  $("tabScan").classList.toggle("on", which === "scan");
  $("boostProfiles").hidden = which !== "profiles";
  $("boostScan").hidden = which !== "scan";
}
$("tabProfiles").onclick = () => boostTab("profiles");
$("tabScan").onclick = () => boostTab("scan");

/* ---------- reusable rows ---------- */
function makeSwitch(checked, label, change) {
  const input = el("input", { type: "checkbox", checked: checked });
  input.setAttribute("aria-label", label);
  input.onchange = async () => {
    input.disabled = true;
    const want = input.checked;
    try { input.checked = await change(want); }
    catch (e) { input.checked = !want; toast(e.message, true); }
    input.disabled = false;
  };
  return el("label", { class: "switch" }, input, el("span", { class: "track" }));
}

function makeRow(name, desc, control, tag) {
  const row = el("div", { class: "row" },
    el("div", { class: "txt" },
      el("div", { class: "name", textContent: name }),
      el("div", { class: "desc", textContent: desc }),
      tag ? el("div", { class: "tag", textContent: tag }) : null),
    control);
  row.dataset.search = (name + " " + desc).toLowerCase();
  return row;
}

function tweakRow(t) {
  const control = makeSwitch(t.enabled, t.name, async want => {
    const r = await api("/api/toggle?id=" + t.id + "&on=" + (want ? 1 : 0), "POST");
    t.enabled = r.on;
    toast((r.on ? "On: " : "Off: ") + t.name + (r.restart ? " (needs a restart or sign-out)" : ""));
    renderProfiles();
    renderScan();
    return r.on;
  });
  return makeRow(t.name, t.desc, control, t.restart ? "Takes effect after a restart or sign-out" : "");
}

async function runJob(id, btn) {
  const old = btn ? btn.textContent : "";
  if (btn) { btn.disabled = true; btn.textContent = "Working..."; }
  try {
    const r = await api("/api/run?id=" + id, "POST");
    toast(r.message);
    if (RELOAD_JOBS.includes(id)) await load();
  } catch (e) { toast(e.message, true); }
  if (btn) { btn.disabled = false; btn.textContent = old; }
}

function jobRow(j) {
  const btn = el("button", { class: "ghost", textContent: "Run" });
  btn.onclick = () => runJob(j.id, btn);
  return makeRow(j.name, j.desc, btn, "");
}

function startupRow(s) {
  const control = makeSwitch(s.enabled, "Start " + s.name + " with Windows", async want => {
    const r = await api("/api/startup/toggle?scope=" + s.scope + "&name=" + encodeURIComponent(s.name) + "&on=" + (want ? 1 : 0), "POST");
    toast((r.on ? "Starts with Windows: " : "Will not start with Windows: ") + s.name);
    return r.on;
  });
  return makeRow(s.name, s.command, control, s.scope === "machine" ? "Applies to all users" : "");
}

function section(title, rows) {
  return el("div", {}, el("h2", { class: "sec", textContent: title }), el("div", { class: "rows" }, rows));
}

/* ---------- boost page ---------- */
function renderProfiles() {
  if (!STATE) return;
  $("cards").replaceChildren(...STATE.profiles.map(p => {
    const apply = el("button", { class: "btn", textContent: "Apply profile" });
    apply.onclick = () => runProfile(p, true, apply);
    const undo = el("button", { class: "ghost", textContent: "Undo" });
    undo.onclick = () => runProfile(p, false, undo);
    const pct = Math.round((p.active / p.total) * 100);
    return el("div", { class: "card pcard" },
      el("div", { class: "tile", textContent: TAGS[p.id] || "" }),
      el("h3", { textContent: p.name }),
      el("p", { textContent: p.tagline }),
      el("div", { class: "count", textContent: p.total + " TWEAKS" }),
      el("div", { class: "bar" }, el("i", { style: "width:" + pct + "%" })),
      el("div", { class: "small", textContent: p.active + " of " + p.total + " active" }),
      apply, undo);
  }));
}

async function runProfile(p, on, btn) {
  const q = on
    ? 'Apply "' + p.name + '"?\n\nA restore point is created first, then up to ' + p.total + ' tweaks are switched on. This can take a minute.'
    : 'Undo "' + p.name + '"?\n\nIts tweaks are switched back to Windows defaults.';
  if (!confirm(q)) return;
  document.querySelectorAll(".pcard button").forEach(b => { b.disabled = true; });
  btn.textContent = "Working...";
  try {
    const r = await api("/api/profile?id=" + p.id + "&on=" + (on ? 1 : 0), "POST");
    toast(r.message);
  } catch (e) { toast(e.message, true); }
  await load();
}

function renderScan() {
  if (!STATE) return;
  const comp = STATE.profiles.find(p => p.id === "competitive");
  const byId = {};
  STATE.tweaks.forEach(t => { byId[t.id] = t; });
  const missing = comp.ids.map(id => byId[id]).filter(t => t && !t.enabled);

  const box = $("boostScan");
  box.replaceChildren(
    el("div", { class: "card", style: "margin-bottom:14px" },
      el("div", { class: "name", textContent: "Scan result" }),
      el("div", { class: "desc", textContent: STATE.cpu + "  |  " + STATE.os }),
      el("div", { class: "desc", textContent: (comp.total - missing.length) + " of " + comp.total + " Competitive tweaks are already on." })),
    missing.length
      ? section("Recommended for you (" + missing.length + ")", missing.map(tweakRow))
      : el("div", { class: "card", textContent: "Nothing to do. Your PC already has every Competitive tweak." }));
}

async function scan() {
  const btn = $("scanBtn");
  btn.disabled = true; btn.textContent = "Scanning...";
  try {
    await load();
    go("boost");
    boostTab("scan");
    const comp = STATE.profiles.find(p => p.id === "competitive");
    toast("Scan done: " + comp.active + " of " + comp.total + " Competitive tweaks are on.");
  } catch (e) { toast(e.message, true); }
  btn.disabled = false; btn.textContent = "Scan System";
}
$("scanBtn").onclick = scan;

/* ---------- fine tune page ---------- */
function renderFine() {
  const groups = {};
  STATE.tweaks.forEach(t => { (groups[t.section] = groups[t.section] || []).push(tweakRow(t)); });
  const names = FINE_ORDER.filter(n => groups[n]);

  $("fineList").replaceChildren(...names.map(n => {
    const s = section(n, groups[n]);
    s.dataset.name = n;
    return s;
  }));

  const chips = ["All"].concat(names);
  $("chips").replaceChildren(...chips.map(n => {
    const b = el("button", { textContent: n });
    b.className = n === chip ? "on" : "";
    b.onclick = () => { chip = n; renderChips(); applyFilter(); };
    return b;
  }));
  applyFilter();
}
function renderChips() {
  document.querySelectorAll("#chips button").forEach(b => b.classList.toggle("on", b.textContent === chip));
}
function applyFilter() {
  const q = $("q").value.trim().toLowerCase();
  document.querySelectorAll("#fineList > div").forEach(sec => {
    let any = false;
    sec.querySelectorAll(".row").forEach(r => {
      const show = !q || r.dataset.search.includes(q);
      r.hidden = !show;
      if (show) any = true;
    });
    sec.hidden = !any || (chip !== "All" && sec.dataset.name !== chip);
  });
}
$("q").oninput = applyFilter;

/* ---------- tools page ---------- */
function renderTools() {
  const groups = {};
  STATE.jobs.forEach(j => { (groups[j.section] = groups[j.section] || []).push(jobRow(j)); });
  const blocks = TOOL_ORDER.filter(n => groups[n]).map(n => section(n, groups[n]));
  if (STARTUP.length) blocks.push(section("Startup apps (on = starts with Windows)", STARTUP.map(startupRow)));
  $("toolList").replaceChildren(...blocks);
}

/* ---------- home page ---------- */
function renderHome() {
  $("cpuName").textContent = STATE.cpu;
  $("osLine").textContent = STATE.os;
  $("quick").replaceChildren(...QUICK.map(q => {
    const b = el("button", { class: "btn alt", textContent: q[1] });
    b.onclick = () => runJob(q[0], b);
    return b;
  }));
}

function setBar(id, pct) {
  const b = $(id);
  b.style.width = pct + "%";
  b.className = pct >= 85 ? "hot" : "";
}

async function poll() {
  try {
    const s = await api("/api/stats");
    $("cpu").textContent = s.cpu + "%";   setBar("cpuBar", s.cpu);
    $("ram").textContent = s.ramPct + "%"; setBar("ramBar", s.ramPct);
    $("ramD").textContent = s.ramUsedGb + " of " + s.ramTotalGb + " GB in use";
    $("disk").textContent = s.diskFreeGb + " GB";
    setBar("diskBar", Math.round(100 - (s.diskFreeGb / s.diskTotalGb) * 100));
    $("diskD").textContent = s.diskTotalGb + " GB total";
  } catch (e) { }
}

/* ---------- loading ---------- */
async function load() {
  const results = await Promise.all([api("/api/state"), api("/api/startup")]);
  STATE = results[0];
  STARTUP = results[1];
  renderHome();
  renderProfiles();
  renderScan();
  renderFine();
  renderTools();
}

/* ---------- sidebar buttons ---------- */
$("fRestore").onclick = () => runJob("restore", $("fRestore"));
$("fUndo").onclick = () => { if (confirm("Switch every tweak that is on back to Windows' own setting?")) runJob("undo", $("fUndo")); };
$("fQuit").onclick = async () => {
  try { await api("/api/quit", "POST"); } catch (e) { }
  document.body.innerHTML = '<p style="margin:40px;font-size:18px">Tweak Panel has closed. You can close this tab.</p>';
};

go("home");
load().catch(e => toast(e.message, true));
poll();
setInterval(poll, 2000);
</script>
</body>
</html>


        "edgebg", "svc-diagtrack", "svc-wap"
    };

    // Competitive plus the more aggressive changes.
    static readonly string[] MaxExtra = new string[]
    {
        "ultimate", "hags", "diskidle", "faststartup", "hibernate", "lastaccess", "pagingexec",
        "nolockscreen", "location", "widgets", "svc-sysmain", "svc-maps", "svc-geo", "svc-retail",
        "svc-insider", "svc-wer", "svc-phone"
    };

    public static readonly List<Profile> All = Build();

    static List<Profile> Build()
    {
        string[] competitive = Essential.Concat(CompetitiveExtra).ToArray();
        // Max uses the Ultimate Performance plan instead of High performance.
        string[] max = competitive.Where(x => x != "power").Concat(MaxExtra).Distinct().ToArray();

        List<Profile> list = new List<Profile>();

        Profile a = new Profile();
        a.Id = "essential";
        a.Name = "Essential Boost";
        a.Tagline = "High-value, low-risk changes for a cleaner, faster gaming setup.";
        a.Ids = Essential;
        list.Add(a);

        Profile b = new Profile();
        b.Id = "competitive";
        b.Name = "Competitive";
        b.Tagline = "Focused changes for lower input delay and steadier frametimes.";
        b.Ids = competitive;
        list.Add(b);

        Profile c = new Profile();
        c.Id = "max";
        c.Name = "Max Performance";
        c.Tagline = "Everything above plus system-wide changes. Highest power use and heat.";
        c.Ids = max;
        list.Add(c);

        return list;
    }

    public static string Apply(string id, bool turnOn)
    {
        Profile p = All.Find(x => x.Id == id);
        if (p == null) throw new ArgumentException("Unknown profile");

        string prefix = "";
        if (turnOn)
        {
            Job restore = Jobs.All.Find(j => j.Id == "restore");
            prefix = restore.Run() + " ";
        }

        bool lowRam = Native.Mem().ullTotalPhys < 15UL * 1073741824UL;
        int changed = 0;
        int already = 0;
        int failed = 0;
        string firstError = "";

        foreach (string tid in p.Ids)
        {
            Tweak t = Catalog.Tweaks.Find(x => x.Id == tid);
            if (t == null) continue;
            if (turnOn && tid == "pagingexec" && lowRam) continue;
            if (!turnOn && tid == "gamemode") continue;

            try
            {
                bool isOn = t.IsOn();
                if (turnOn)
                {
                    if (isOn) { already++; continue; }
                    t.On();
                }
                else
                {
                    if (!isOn) continue;
                    t.Off();
                }
                changed++;
            }
            catch (Exception e)
            {
                failed++;
                if (firstError == "") firstError = t.Name + ": " + e.Message;
            }
        }

        string text;
        if (turnOn)
            text = prefix + p.Name + ": " + changed + " switched on, " + already + " already on.";
        else
            text = p.Name + ": " + changed + " switched back to Windows defaults.";
        if (failed > 0) text += " " + failed + " failed (" + firstError.Trim() + ").";
        return text;
    }
}

using System.Diagnostics;
using System.Net;
using System.Reflection;
using System.Security.Principal;
using System.Text;
using System.Text.Json;

string token = Guid.NewGuid().ToString("N");
JsonSerializerOptions jsonOpt = new JsonSerializerOptions();
jsonOpt.PropertyNamingPolicy = JsonNamingPolicy.CamelCase;

// Load the web page that is built into the exe.
string html = "";
{
    Assembly asm = Assembly.GetExecutingAssembly();
    string resName = "";
    foreach (string n in asm.GetManifestResourceNames())
    {
        if (n.EndsWith("index.html")) resName = n;
    }
    using (Stream s = asm.GetManifestResourceStream(resName))
    using (StreamReader r = new StreamReader(s, Encoding.UTF8))
    {
        html = r.ReadToEnd().Replace("__TOKEN__", token);
    }
}

using (WindowsIdentity identity = WindowsIdentity.GetCurrent())
{
    if (!new WindowsPrincipal(identity).IsInRole(WindowsBuiltInRole.Administrator))
        Console.WriteLine("Warning: not running as administrator. Some tweaks will fail.");
}

HttpListener listener = null;
int port = 5173;
for (; port < 5190; port++)
{
    try
    {
        HttpListener l = new HttpListener();
        l.Prefixes.Add("http://127.0.0.1:" + port + "/");
        l.Start();
        listener = l;
        break;
    }
    catch { }
}
if (listener == null)
{
    Console.WriteLine("Could not start: no free port between 5173 and 5189.");
    return;
}

string url = "http://127.0.0.1:" + port + "/";
Console.WriteLine("Tweak Panel is running at " + url);
Console.WriteLine("Leave this window open. Close it, or press Quit in the panel, to stop.");

// explorer.exe opens the link in your normal browser, not in an admin one.
try { Process.Start(new ProcessStartInfo("explorer.exe", url)); }
catch { Console.WriteLine("Open this address in your browser: " + url); }

while (true)
{
    HttpListenerContext ctx = await listener.GetContextAsync();
    _ = Task.Run(() => Handle(ctx));
}

void Send(HttpListenerResponse rs, string type, string body)
{
    byte[] bytes = Encoding.UTF8.GetBytes(body);
    rs.ContentType = type + "; charset=utf-8";
    rs.Headers["Cache-Control"] = "no-store";
    rs.ContentLength64 = bytes.Length;
    rs.OutputStream.Write(bytes, 0, bytes.Length);
}

string Json(object value)
{
    return JsonSerializer.Serialize(value, value.GetType(), jsonOpt);
}

void Handle(HttpListenerContext c)
{
    HttpListenerRequest rq = c.Request;
    HttpListenerResponse rs = c.Response;
    try
    {
        // Only our own page (with our secret token) may call the API.
        string host = rq.UserHostName ?? "";
        if (!host.StartsWith("127.0.0.1") && !host.StartsWith("localhost"))
        {
            rs.StatusCode = 403;
            return;
        }

        string path = rq.Url.AbsolutePath;
        if (path == "/")
        {
            Send(rs, "text/html", html);
            return;
        }
        if (rq.Headers["X-Token"] != token)
        {
            rs.StatusCode = 401;
            return;
        }

        var q = rq.QueryString;
        bool post = rq.HttpMethod == "POST";

        if (path == "/api/state")
        {
            Send(rs, "application/json", Json(Catalog.State()));
        }
        else if (path == "/api/stats")
        {
            Send(rs, "application/json", Json(Stats.Read()));
        }
        else if (path == "/api/startup")
        {
            Send(rs, "application/json", Json(Startup.GetAll()));
        }
        else if (path == "/api/startup/toggle" && post)
        {
            bool now = Startup.Set(q["scope"] ?? "", q["name"] ?? "", q["on"] == "1");
            Send(rs, "application/json", Json(new { ok = true, on = now }));
        }
        else if (path == "/api/toggle" && post)
        {
            Tweak t = Catalog.Tweaks.Find(x => x.Id == q["id"]);
            if (t == null) { rs.StatusCode = 404; return; }
            if (q["on"] == "1") t.On(); else t.Off();
            Send(rs, "application/json", Json(new { ok = true, on = t.IsOn(), restart = t.Restart }));
        }
        else if (path == "/api/run" && post)
        {
            Job j = Jobs.All.Find(x => x.Id == q["id"]);
            if (j == null) { rs.StatusCode = 404; return; }
            Send(rs, "application/json", Json(new { ok = true, message = j.Run() }));
        }
        else if (path == "/api/profile" && post)
        {
            string msg = Profiles.Apply(q["id"] ?? "", q["on"] == "1");
            Send(rs, "application/json", Json(new { ok = true, message = msg }));
        }
        else if (path == "/api/quit" && post)
        {
            Send(rs, "application/json", Json(new { ok = true }));
            Task.Run(() => { Thread.Sleep(300); Environment.Exit(0); });
        }
        else
        {
            rs.StatusCode = 404;
        }
    }
    catch (Exception e)
    {
        try
        {
            rs.StatusCode = 500;
            Send(rs, "application/json", Json(new { ok = false, message = e.Message }));
        }
        catch { }
    }
    finally
    {
        rs.Close();
    }
}


public static class Native
{
    [StructLayout(LayoutKind.Sequential)]
    public struct MEMSTAT
    {
        public uint dwLength;
        public uint dwMemoryLoad;
        public ulong ullTotalPhys;
        public ulong ullAvailPhys;
        public ulong ullTotalPageFile;
        public ulong ullAvailPageFile;
        public ulong ullTotalVirtual;
        public ulong ullAvailVirtual;
        public ulong ullAvailExtendedVirtual;
    }

    [DllImport("kernel32.dll")]
    public static extern bool GlobalMemoryStatusEx(ref MEMSTAT m);

    [DllImport("kernel32.dll")]
    public static extern bool GetSystemTimes(out long idle, out long kernel, out long user);

    [DllImport("psapi.dll")]
    public static extern bool EmptyWorkingSet(IntPtr process);

    [DllImport("shell32.dll", CharSet = CharSet.Unicode)]
    public static extern int SHEmptyRecycleBin(IntPtr hwnd, string root, uint flags);

    public static MEMSTAT Mem()
    {
        MEMSTAT m = new MEMSTAT();
        m.dwLength = (uint)Marshal.SizeOf(typeof(MEMSTAT));
        GlobalMemoryStatusEx(ref m);
        return m;
    }
}

public static class Win
{
    public static readonly RegistryKey HKCU = Registry.CurrentUser;
    public static readonly RegistryKey HKLM = Registry.LocalMachine;

    // ---------------- running programs ----------------

    public static string Sh(string exe, string args, out int code)
    {
        ProcessStartInfo psi = new ProcessStartInfo(exe, args);
        psi.RedirectStandardOutput = true;
        psi.RedirectStandardError = true;
        psi.UseShellExecute = false;
        psi.CreateNoWindow = true;
        using (Process p = Process.Start(psi))
        {
            Task<string> err = p.StandardError.ReadToEndAsync();
            string output = p.StandardOutput.ReadToEnd();
            p.WaitForExit();
            output += err.Result;
            code = p.ExitCode;
            return output;
        }
    }

    // Runs a program and throws if it fails, so the panel can show the reason.
    public static void Cmd(string exe, string args)
    {
        int code;
        string o = Sh(exe, args, out code);
        if (code != 0)
        {
            string msg = o.Trim();
            if (msg.Length == 0) msg = exe + " failed (code " + code + ")";
            throw new Exception(msg);
        }
    }

    // Opens a visible window for long jobs (sfc, dism, chkdsk...).
    public static string Window(string title, string commandLine)
    {
        ProcessStartInfo psi = new ProcessStartInfo("cmd.exe",
            "/c title " + title + " & " + commandLine + " & echo. & echo Finished. You can close this window. & pause");
        psi.UseShellExecute = true;
        Process.Start(psi);
        return "Started in a new window. It can take a while. Close that window when it says Finished.";
    }

    // ---------------- registry ----------------

    public static object Get(RegistryKey root, string path, string name)
    {
        using (RegistryKey k = root.OpenSubKey(path))
        {
            if (k == null) return null;
            return k.GetValue(name);
        }
    }

    static void Apply(RegVal v, bool on)
    {
        object val = on ? v.On : v.Off;
        if (val == null)
        {
            using (RegistryKey k = v.Root.OpenSubKey(v.Path, true))
            {
                if (k != null) k.DeleteValue(v.Name, false);
            }
            return;
        }
        using (RegistryKey k2 = v.Root.CreateSubKey(v.Path, true))
        {
            k2.SetValue(v.Name, val, v.Kind);
        }
    }

    // A number setting. off == null deletes the value.
    public static RegVal Dw(RegistryKey root, string path, string name, int on, int? off)
    {
        object offVal = null;
        if (off.HasValue) offVal = off.Value;
        return new RegVal(root, path, name, on, offVal, RegistryValueKind.DWord);
    }

    // A text setting. off == null deletes the value.
    public static RegVal Str(RegistryKey root, string path, string name, string on, string off)
    {
        return new RegVal(root, path, name, on, off, RegistryValueKind.String);
    }

    static Tweak Make(string id, string section, string name, string desc, bool restart)
    {
        Tweak t = new Tweak();
        t.Id = id;
        t.Section = section;
        t.Name = name;
        t.Desc = desc;
        t.Restart = restart;
        return t;
    }

    // Registry switch. The first value decides whether it shows as on.
    // defOn = what to show when that value does not exist yet.
    public static Tweak Toggle(string id, string section, string name, string desc, bool restart, bool defOn, params RegVal[] vals)
    {
        Tweak t = Make(id, section, name, desc, restart);
        t.IsOn = () =>
        {
            object cur = Get(vals[0].Root, vals[0].Path, vals[0].Name);
            if (cur == null) return defOn;
            return cur.Equals(vals[0].On);
        };
        t.On = () => { foreach (RegVal v in vals) Apply(v, true); };
        t.Off = () => { foreach (RegVal v in vals) Apply(v, false); };
        return t;
    }

    // Switch with your own code.
    public static Tweak Custom(string id, string section, string name, string desc, bool restart, Func<bool> isOn, Action on, Action off)
    {
        Tweak t = Make(id, section, name, desc, restart);
        t.IsOn = isOn;
        t.On = on;
        t.Off = off;
        return t;
    }

    // ---------------- services ----------------

    // Switch that disables a Windows service. restoreStart: auto, delayed-auto or demand (the Windows default).
    public static Tweak Service(string id, string section, string name, string desc, string svc, string restoreStart)
    {
        Tweak t = Make(id, section, name, desc, false);
        t.IsOn = () =>
        {
            object v = Get(HKLM, @"SYSTEM\CurrentControlSet\Services\" + svc, "Start");
            return v != null && v.Equals(4);
        };
        t.On = () =>
        {
            Cmd("sc.exe", "config " + svc + " start= disabled");
            int c;
            Sh("sc.exe", "stop " + svc, out c);
        };
        t.Off = () =>
        {
            Cmd("sc.exe", "config " + svc + " start= " + restoreStart);
            if (restoreStart != "demand")
            {
                int c;
                Sh("sc.exe", "start " + svc, out c);
            }
        };
        return t;
    }

    // ---------------- power ----------------

    static string FirstGuid(string text)
    {
        Match m = Regex.Match(text, @"[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}");
        return m.Success ? m.Value : "";
    }

    public static string ActiveScheme()
    {
        int c;
        return Sh("powercfg.exe", "/getactivescheme", out c);
    }

    static string FindScheme(string nameContains)
    {
        int c;
        string o = Sh("powercfg.exe", "/list", out c);
        foreach (string line in o.Split('\n'))
        {
            if (line.IndexOf(nameContains, StringComparison.OrdinalIgnoreCase) >= 0)
            {
                string g = FirstGuid(line);
                if (g != "") return g;
            }
        }
        return "";
    }

    // Switches to a power plan, creating it first if Windows is hiding it.
    public static void ActivateScheme(string name, string templateGuid)
    {
        string guid = FindScheme(name);
        if (guid == "")
        {
            int c;
            string o = Sh("powercfg.exe", "/duplicatescheme " + templateGuid, out c);
            guid = FirstGuid(o);
            if (guid == "") throw new Exception("This PC does not offer the " + name + " plan.");
        }
        Cmd("powercfg.exe", "/setactive " + guid);
    }

    static void SetAc(string sub, string setting, int value)
    {
        Cmd("powercfg.exe", "/setacvalueindex SCHEME_CURRENT " + sub + " " + setting + " " + value);
        Cmd("powercfg.exe", "/setactive SCHEME_CURRENT");
    }

    // Switch for one setting of the current power plan (plugged in).
    public static Tweak PowerSetting(string id, string section, string name, string desc, string sub, string setting, int onValue, int offValue)
    {
        Tweak t = Make(id, section, name, desc, false);
        t.IsOn = () =>
        {
            int c;
            string o = Sh("powercfg.exe", "/query SCHEME_CURRENT " + sub + " " + setting, out c);
            Match m = Regex.Match(o, @"Current AC Power Setting Index:\s*0x([0-9a-fA-F]+)");
            if (!m.Success) return false;
            return Convert.ToInt32(m.Groups[1].Value, 16) == onValue;
        };
        t.On = () => SetAc(sub, setting, onValue);
        t.Off = () => SetAc(sub, setting, offValue);
        return t;
    }

    // ---------------- network ----------------

    const string IfacePath = @"SYSTEM\CurrentControlSet\Services\Tcpip\Parameters\Interfaces";

    public static Tweak Nagle(string id, string section, string name, string desc)
    {
        Tweak t = Make(id, section, name, desc, true);
        t.IsOn = () =>
        {
            using (RegistryKey k = HKLM.OpenSubKey(IfacePath))
            {
                if (k == null) return false;
                foreach (string n in k.GetSubKeyNames())
                {
                    object v = Get(HKLM, IfacePath + @"\" + n, "TCPNoDelay");
                    if (v != null && v.Equals(1)) return true;
                }
            }
            return false;
        };
        t.On = () =>
        {
            using (RegistryKey k = HKLM.OpenSubKey(IfacePath))
            {
                foreach (string n in k.GetSubKeyNames())
                {
                    using (RegistryKey sk = HKLM.OpenSubKey(IfacePath + @"\" + n, true))
                    {
                        if (sk == null) continue;
                        sk.SetValue("TcpAckFrequency", 1, RegistryValueKind.DWord);
                        sk.SetValue("TCPNoDelay", 1, RegistryValueKind.DWord);
                    }
                }
            }
        };
        t.Off = () =>
        {
            using (RegistryKey k = HKLM.OpenSubKey(IfacePath))
            {
                foreach (string n in k.GetSubKeyNames())
                {
                    using (RegistryKey sk = HKLM.OpenSubKey(IfacePath + @"\" + n, true))
                    {
                        if (sk == null) continue;
                        sk.DeleteValue("TcpAckFrequency", false);
                        sk.DeleteValue("TCPNoDelay", false);
                    }
                }
            }
        };
        return t;
    }

    // ---------------- files ----------------

    public static long DeleteContents(string dir)
    {
        long freed = 0;
        if (!Directory.Exists(dir)) return 0;

        EnumerationOptions opt = new EnumerationOptions();
        opt.RecurseSubdirectories = true;
        opt.IgnoreInaccessible = true;
        opt.AttributesToSkip = 0;

        string[] files;
        try { files = Directory.GetFiles(dir, "*", opt); }
        catch { return 0; }

        foreach (string f in files)
        {
            try
            {
                FileInfo fi = new FileInfo(f);
                long len = fi.Length;
                fi.Attributes = FileAttributes.Normal;
                fi.Delete();
                freed += len;
            }
            catch { }
        }

        string[] dirs;
        try { dirs = Directory.GetDirectories(dir); }
        catch { return freed; }

        foreach (string d in dirs)
        {
            try { Directory.Delete(d, true); } catch { }
        }
        return freed;
    }

    public static string Mb(long bytes)
    {
        return (bytes / 1048576.0).ToString("0.#") + " MB";
    }
}


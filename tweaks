    static string Preset(string[] ids, bool turnOn)
    {
        int ok = 0;
        string err = "";
        foreach (string id in ids)
        {
            Tweak t = Catalog.Tweaks.Find(x => x.Id == id);
            if (t == null) continue;
            try
            {
                if (turnOn) t.On(); else t.Off();
                ok++;
            }
            catch (Exception e) { err = e.Message; }
        }
        string text = (turnOn ? "Switched on " : "Switched off ") + ok + " of " + ids.Length + " settings.";
        if (err != "") text += " Problem: " + err;
        return text;
    }

    static int Boost(Func<string, bool> match, ProcessPriorityClass level)
    {
        int n = 0;
        foreach (Process p in Process.GetProcesses())
        {
            try
            {
                if (match(p.ProcessName))
                {
                    p.PriorityClass = level;
                    n++;
                }
            }
            catch { }
            p.Dispose();
        }
        return n;
    }

    static string Folder(Environment.SpecialFolder f)
    {
        return Environment.GetFolderPath(f);
    }

    static string Dns(string primary, string secondary)
    {
        int code;
        string o = Sh("powershell.exe",
            "-NoProfile -Command \"Get-NetAdapter | Where-Object { $_.Status -eq 'Up' } | ForEach-Object { Set-DnsClientServerAddress -InterfaceIndex $_.ifIndex -ServerAddresses ('" + primary + "','" + secondary + "') }\"",
            out code);
        if (code != 0) return "Could not change DNS: " + o.Trim();
        Sh("ipconfig.exe", "/flushdns", out code);
        return "DNS set to " + primary + " and " + secondary + ".";
    }


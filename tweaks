// One registry value a tweak changes. Off == null means "delete the value" (back to the Windows default).
public class RegVal
{
    public RegistryKey Root;
    public string Path;
    public string Name;
    public object On;
    public object Off;
    public RegistryValueKind Kind;

    public RegVal(RegistryKey root, string path, string name, object on, object off, RegistryValueKind kind)
    {
        Root = root;
        Path = path;
        Name = name;
        On = on;
        Off = off;
        Kind = kind;
    }
}


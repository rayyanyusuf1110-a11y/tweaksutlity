    static bool Safe(Func<bool> f)
    {
        try { return f(); }
        catch { return false; }
    }

    public static object State()
    {
        List<object> tweaks = new List<object>();
        Dictionary<string, bool> map = new Dictionary<string, bool>();
        foreach (Tweak t in Tweaks)
        {
            bool isOn = Safe(t.IsOn);
            map[t.Id] = isOn;
            tweaks.Add(new { id = t.Id, section = t.Section, name = t.Name, desc = t.Desc, restart = t.Restart, enabled = isOn });
        }

        List<object> jobs = new List<object>();
        foreach (Job j in Jobs.All)
        {
            jobs.Add(new { id = j.Id, section = j.Section, name = j.Name, desc = j.Desc });
        }

        List<object> profiles = new List<object>();
        foreach (Profile p in Profiles.All)
        {
            int active = 0;
            foreach (string id in p.Ids)
            {
                bool v;
                if (map.TryGetValue(id, out v) && v) active++;
            }
            profiles.Add(new { id = p.Id, name = p.Name, tagline = p.Tagline, total = p.Ids.Length, active = active, ids = p.Ids });
        }

        object cpu = Get(HKLM, @"HARDWARE\DESCRIPTION\System\CentralProcessor\0", "ProcessorNameString");
        string cpuName = cpu == null ? "" : cpu.ToString().Trim();

        return new
        {
            os = System.Runtime.InteropServices.RuntimeInformation.OSDescription,
            cpu = cpuName,
            tweaks = tweaks,
            jobs = jobs,
            profiles = profiles
        };
    }
}


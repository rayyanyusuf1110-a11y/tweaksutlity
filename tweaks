using Microsoft.Win32;

public static class Startup
{
    const string Run = @"Software\Microsoft\Windows\CurrentVersion\Run";
    const string Approved = @"Software\Microsoft\Windows\CurrentVersion\Explorer\StartupApproved\Run";

    static RegistryKey Root(string scope)
    {
        if (scope == "machine") return Registry.LocalMachine;
        if (scope == "user") return Registry.CurrentUser;
        throw new ArgumentException("Unknown scope");
    }

    // Lists the programs that start with Windows. Uses the same switch as Task Manager,
    // so turning one off keeps it in the list and it can be turned back on.
    public static List<object> GetAll()
    {
        List<object> result = new List<object>();
        foreach (string scope in new string[] { "user", "machine" })
        {
            using (RegistryKey run = Root(scope).OpenSubKey(Run))
            {
                if (run == null) continue;
                using (RegistryKey ap = Root(scope).OpenSubKey(Approved))
                {
                    foreach (string name in run.GetValueNames())
                    {
                        if (name.Length == 0) continue;
                        bool enabled = true;
                        if (ap != null)
                        {
                            byte[] b = ap.GetValue(name) as byte[];
                            if (b != null && b.Length > 0 && (b[0] & 1) == 1) enabled = false;
                        }
                        object cmd = run.GetValue(name);
                        string command = cmd == null ? "" : cmd.ToString();
                        result.Add(new { scope = scope, name = name, command = command, enabled = enabled });
                    }
                }
            }
        }
        return result;
    }

    public static bool Set(string scope, string name, bool enabled)
    {
        using (RegistryKey run = Root(scope).OpenSubKey(Run))
        {
            if (run == null || run.GetValue(name) == null) throw new ArgumentException("Unknown startup entry");
        }
        using (RegistryKey ap = Root(scope).CreateSubKey(Approved, true))
        {
            byte[] b = new byte[12];
            b[0] = (byte)(enabled ? 2 : 3);
            if (!enabled) BitConverter.GetBytes(DateTime.UtcNow.ToFileTimeUtc()).CopyTo(b, 4);
            ap.SetValue(name, b, RegistryValueKind.Binary);
        }
        return enabled;
    }
}

public static class Stats
{
    static long lastIdle = 0;
    static long lastKernel = 0;
    static long lastUser = 0;
    static readonly object gate = new object();

    public static object Read()
    {
        long idle, kernel, user;
        Native.GetSystemTimes(out idle, out kernel, out user);

        double cpu = 0;
        lock (gate)
        {
            long total = (kernel - lastKernel) + (user - lastUser);
            long idleDiff = idle - lastIdle;
            if (lastKernel != 0 && total > 0) cpu = 100.0 * (total - idleDiff) / total;
            lastIdle = idle;
            lastKernel = kernel;
            lastUser = user;
        }
        if (cpu < 0) cpu = 0;
        if (cpu > 100) cpu = 100;

        Native.MEMSTAT m = Native.Mem();
        double usedGb = (m.ullTotalPhys - m.ullAvailPhys) / 1073741824.0;
        double totalGb = m.ullTotalPhys / 1073741824.0;

        double freeDisk = 0;
        double totalDisk = 1;
        try
        {
            DriveInfo drive = new DriveInfo(Path.GetPathRoot(Environment.SystemDirectory));
            freeDisk = drive.AvailableFreeSpace / 1073741824.0;
            totalDisk = drive.TotalSize / 1073741824.0;
        }
        catch { }

        return new
        {
            cpu = Math.Round(cpu),
            ramPct = (int)m.dwMemoryLoad,
            ramUsedGb = Math.Round(usedGb, 1),
            ramTotalGb = Math.Round(totalGb, 1),
            diskFreeGb = Math.Round(freeDisk),
            diskTotalGb = Math.Round(totalDisk)
        };
    }
}

